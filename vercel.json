{
  "buildCommand": "pnpm --filter @workspace/agrivision-ai build",
  "outputDirectory": "artifacts/agrivision-ai/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
